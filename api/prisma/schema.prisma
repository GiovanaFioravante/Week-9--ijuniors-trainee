generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  senha     String
  createdAt DateTime @default(now())

  serviceOrders ServiceOrder[]
}

model Client {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String   @unique
  createdAt DateTime @default(now())

  serviceOrders ServiceOrder[]
}

enum ServiceOrderStatus {
  open
  in_progress
  done
}

model ServiceOrder {
  id        Int                @id @default(autoincrement())
  device    String
  issue     String
  status    ServiceOrderStatus @default(open)
  createdAt DateTime           @default(now())

  clientId Int
  client   Client @relation(fields: [clientId], references: [id])

  criadoPorId Int
  criadoPor   Usuario @relation(fields: [criadoPorId], references: [id])
}